# ============================================================================
# Scalar Monorepo - Environment Variables
# ============================================================================
# Copy this file to .env.development.local for local development
# Set these values in your Vercel project settings for production
# ============================================================================

# ============================================================================
# Vercel Integration (Required for Deployment)
# ============================================================================

# Vercel Web Analytics - Track performance metrics
# Get this from: https://vercel.com/dashboard/project/{PROJECT_ID}/analytics
VERCEL_WEB_ANALYTICS_ID=

# Vercel OIDC Token - For identity verification and secure deployments
# Automatically configured by Vercel for CI/CD environments
VERCEL_OIDC_TOKEN=

# ============================================================================
# AI Integration (Optional - AI SDK Features)
# ============================================================================

# AI Gateway API Key - For AI SDK integration with Claude, GPT, etc.
# Get this from: https://console.vercel.com/integrations
# Used by: @scalar/ai-* packages and examples
AI_GATEWAY_API_KEY=

# ============================================================================
# Build Environment
# ============================================================================

# Node Environment
# Default: production (automatically set by Vercel)
NODE_ENV=production

# Enable debug logging during builds
# Default: false
DEBUG=

# Turbo API for distributed caching
# Optional: for faster builds in CI/CD
TURBO_API=
TURBO_TOKEN=
TURBO_TEAM=

# ============================================================================
# Development Environment (Local Only)
# ============================================================================

# Enable development-only features
# Default: false
DEVELOPMENT=false

# Mock API server port
# Default: 3000
PORT=3000

# Enable verbose logging
# Default: false
VERBOSE=

# ============================================================================
# Framework-Specific Configuration
# ============================================================================

# Next.js / Nuxt specific
# Automatically managed by framework, no manual configuration needed

# Vue / React development
# Development tools are auto-enabled in dev mode

# ============================================================================
# Security & Secrets
# ============================================================================

# IMPORTANT: Never commit actual secret values!
# Use Vercel's Environment Variables section to set these securely
# Reference: https://vercel.com/docs/projects/environment-variables

# OAuth / API Keys (if integrations are added)
# GITHUB_TOKEN=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Database Secrets (if applicable)
# DATABASE_URL=

# ============================================================================
# Monitoring & Analytics
# ============================================================================

# PostHog Analytics (if enabled)
# POSTHOG_API_KEY=
# POSTHOG_API_HOST=

# Error tracking (if Sentry is enabled)
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ============================================================================
# Build Optimization
# ============================================================================

# Playwright testing configuration
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=false

# Skip expensive operations in preview deployments
# SKIP_BUILD_PRODUCT_STATS=

# ============================================================================
# Documentation
# ============================================================================

# See DEPLOYMENT.md for complete setup instructions
# See MIGRATION_PLAN.md for architecture details
# See README.md for development guidelines

# For local development:
# 1. Copy this file: cp .env.example .env.development.local
# 2. Fill in required variables
# 3. Run: pnpm install && pnpm dev

# For Vercel deployments:
# 1. Go to https://vercel.com/dashboard
# 2. Select your project
# 3. Go to Settings → Environment Variables
# 4. Add each variable with its value
# 5. Set which deployments can access each variable (Production/Preview/Development)

# ============================================================================
